# Copiar a backend/.env; ejecutar la API/worker desde backend/.
APP_ENV=development
DEBUG=false
APP_NAME=junta_electoral
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://junta_local:REEMPLAZAR@127.0.0.1:5432/junta_electoral
# Generar: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES_ALEATORIOS
ALGORITHM=HS256
JWT_ISSUER=junta-electoral
JWT_AUDIENCE=junta-electoral-web
JWT_KEY_ID=current
# Rotación: JSON de kid anterior -> secreto anterior. Retirar tras vencer access (15 min + 5 s).
JWT_PREVIOUS_KEYS={}
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_HOURS=24
REAUTH_MINUTES=5
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173
SUPPORT_CONTACT=
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
# Cuotas por ventana de 15 minutos; recuperación y reauth: 5 por identificador.
AUTH_IP_LIMIT=100
AUTH_IDENTIFIER_LIMIT=20
RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_HOURS=48
INVITATION_HOURLY_LIMIT=20
MAIL_COOLDOWN_SECONDS=60
# Mailpit local captura mensajes, sin reenviarlos a Internet.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Junta Electoral <no-reply@junta.local>"
SMTP_TLS=none
SMTP_TIMEOUT=10
# Generar: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MAIL_OUTBOX_KEY=
MAIL_MAX_ATTEMPTS=5
MAIL_LEASE_SECONDS=120
SECURITY_RETENTION_DAYS=30
# Solo bootstrap, sin valores reales versionados.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=Administrador inicial
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# Producción: APP_ENV=production, DEBUG=false, HTTPS, COOKIE_SECURE=true,
# CORS exacto mismo sitio, SMTP_TLS=starttls (587) o ssl (465), proveedor/remitente verificados.
